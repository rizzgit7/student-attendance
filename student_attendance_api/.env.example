# Copy to .env and fill in real values. Secrets only in env vars (§16).
SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL in production; SQLite default for local dev
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/attendance
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=604800
RATELIMIT_LOGIN=10
RATELIMIT_CHECKIN=10
