{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(auth|attendance|student|teacher|admin|reports)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/student-attendance-v1.0.0.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}